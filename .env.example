# Epic FHIR R4 sandbox (register at https://fhir.epic.com/)
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_CLIENT_ID=replace-with-your-sandbox-client-id
EPIC_REDIRECT_URI=http://127.0.0.1:8000/callback
# Leave unset for a public/native-style SMART client. Do not commit a real secret.
EPIC_CLIENT_SECRET=
# Comma-separated optional override. Otherwise the application uses least-privilege
# read/search SMART R4 scopes for the resources described in the README.
EPIC_SCOPES=
# Set to true only after adding the three matching R4 Search APIs in Epic's
# Incoming APIs list and letting the sandbox configuration synchronize.
EPIC_ENABLE_EXTENDED_CLINICAL_DATA=false
HOST=127.0.0.1
PORT=8000
